{
  "name": "StriveM8D8",
  "version": "1.0.0",
  "description": "Now that you have seen how to have sockets join rooms from the backend, implement a 1 to 1 chat, considering that socket.io is conveniently having each socket join automatically a room which has the same name of that socket id.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "nodemon -r dotenv/config ./src/index.js",
    "start": "node ./src/index.js",
    "lint": "oxlint --deny-warnings src test vitest.config.js",
    "e2e": "pnpm --dir e2e test",
    "dev:all": "concurrently --names server,client --prefix-colors blue,green \"pnpm dev\" \"pnpm --dir client dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nando-C/StriveM8D8.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Nando-C/StriveM8D8/issues"
  },
  "homepage": "https://github.com/Nando-C/StriveM8D8#readme",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "oxlint": "^1.93.0",
    "socket.io-client": "^4.8.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-list-endpoints": "^7.1.1",
    "http-errors": "^2.0.1",
    "mongoose": "^9.12.1",
    "socket.io": "^4.8.4"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  }
}
